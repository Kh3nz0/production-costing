# Supabase project Connect dialog
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Existing projects can keep their legacy anon key during migration:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where recovery and confirmation links come back to. Must also be listed under
# Authentication -> URL Configuration -> Redirect URLs in the Supabase dashboard,
# or the link will bounce to the Site URL and the reset screen will never be reached.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Throwaway account used only by the authenticated Playwright checks. Keep the
# real values in the shell or .env.local; never commit its password.
E2E_EMAIL=
E2E_PASSWORD=
